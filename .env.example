# Copy to .env on the server and fill in real values before `docker compose up -d`.

# Public URL the web app's browser bundle calls (baked in at build time).
VITE_ALBUS_API_URL=https://api.albus.workflowsolved.com

# Chain parameters. Leave unset for the mainnet defaults. Any value set here changes the
# networkId, so such a node cannot talk to the mainnet (testnet only).
# INITIAL_DIFFICULTY=256        (in 1/16 Bit; 64 = one hex zero)
# TARGET_BLOCK_TIME_MS=60000
# RETARGET_TAU_MS=1800000
# HALVING_INTERVAL_BLOCKS=1050000

# Protection (does not change the networkId).
# RATE_READ_PER_MIN=600
# RATE_WRITE_PER_MIN=60
# P2P_MAX_CONN_PER_IP=4
# MINING_MAX_CONN_PER_IP=8
# P2P_ALLOW_PRIVATE=1           (testnet only: allows private peer addresses)

# P2P: other nodes to connect to (comma separated ws://host/p2p) and this node's own public URL.
# PEERS=
# P2P_PUBLIC_URL=
