# Copy to .env and fill in real values. Never commit the real .env.

# --- Identity ---
WORKER_ID=gpu-node-lux-01
WORKER_TOKEN=replace-with-a-long-random-per-worker-token
SOFTWARE_VERSION=0.1.0

# --- Central API ---
ALBUS_API_BASE_URL=https://albus.workflowsolved.com/api/v1
API_TIMEOUT_SECONDS=10
API_RETRY_ATTEMPTS=3

# --- Signature verification ---
# Path inside the container to a read-only JSON file: {"key_id": "base64-ed25519-pubkey", ...}
PUBLIC_KEYS_PATH=/app/config/public-keys.json
MAX_CLOCK_SKEW_SECONDS=30
COMMAND_MAX_LIFETIME_SECONDS=300

# --- Profiles ---
PROFILES_PATH=/app/config/profiles.yaml

# --- Replay protection ---
REPLAY_STORE_PATH=/data/replay-store.sqlite3
REPLAY_RETENTION_SECONDS=3600

# --- Intervals (seconds) ---
TELEMETRY_INTERVAL_SECONDS=30
DESIRED_STATE_POLL_INTERVAL_SECONDS=15
HEARTBEAT_FAILURE_GRACE_SECONDS=300

# --- Thermal / power policy ---
GPU_WARNING_TEMP_C=75
GPU_STOP_TEMP_C=80
GPU_RESUME_TEMP_C=65
GPU_MAX_POWER_WATTS=300

# --- Restart policy ---
MINER_MAX_RESTARTS=3
MINER_RESTART_WINDOW_SECONDS=600

# --- Local control endpoints ---
LOCAL_BIND_HOST=127.0.0.1
LOCAL_BIND_PORT=9477

# --- Development ---
# When true, uses the mock miner and a fake GPU reading if nvidia-smi is unavailable.
DEV_MODE=false
